<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AuthV4</AssemblyName>
    <Version>4.0.1</Version>
    <PackageId>AuthV4</PackageId>
    <Authors>Authris</Authors>
    <Description>Authris license client SDK</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/V12KLT/authris-sdk.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>licensing;auth;hwid;drm</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\AuthV4.cs" />
  </ItemGroup>
</Project>
